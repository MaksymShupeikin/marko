# TEMPLATE_ONLY=1
# This file is intentionally invalid for deployment until every REQUIRED value is replaced.
ENVIRONMENT=production
DEBUG=false
API_DOCS_ENABLED=false
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@PRIVATE_POSTGRES_HOST:5432/marko
CELERY_BROKER_URL=rediss://USER:PASSWORD@PRIVATE_REDIS_HOST:6380/0
CELERY_RESULT_BACKEND=rediss://USER:PASSWORD@PRIVATE_REDIS_HOST:6380/1
ALLOWED_HOSTS=api.example.com
CORS_ORIGINS=https://app.example.com
FIREBASE_PROJECT_ID=your-firebase-project
# Safe only because compose.production.yaml does not publish the API container;
# all public requests reach it through Caddy on the private edge network.
TRUSTED_PROXY_IPS=*
PUBLIC_API_BASE_URL=https://api.example.com
FIREBASE_API_KEY=replace
FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=replace
FIREBASE_WEB_APP_ID=replace

# Public DNS records must resolve to this deployment host before Caddy starts.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# Keep blocked until an official feed or written authorization is recorded.
PROM_MARKETPLACE_SOURCE_ACCESS_VERDICT=NOT_PERMITTED
PROM_MARKETPLACE_SOURCE_ACCESS_REFERENCE=

# REQUIRED for Yuri cost storage. Provision the key through the deployment
# secret manager; this template value is intentionally non-functional.
COST_PRIVACY_MODE=SERVER_SIDE_ENCRYPTED
COST_ENCRYPTION_ACTIVE_KEY_ID=replace-key-id
COST_ENCRYPTION_KEYS_JSON={"replace-key-id":"REPLACE_WITH_BASE64URL_32_BYTE_KEY"}

API_PORT=8000
WEB_PORT=8080
API_WORKERS=2
GENERAL_WORKER_CONCURRENCY=1
STORE_SYNC_WORKER_CONCURRENCY=2
PRICING_WORKER_CONCURRENCY=1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

SCHEDULER_SINGLETON_TTL_SECONDS=90
SCHEDULER_SINGLETON_REFRESH_SECONDS=20
SCHEDULER_SINGLETON_REACQUIRE_INITIAL_SECONDS=1
SCHEDULER_SINGLETON_REACQUIRE_MAX_SECONDS=30

# Fail-closed feature activation. A boolean alone is never sufficient in production.
PRICING_V3_ROBUST_DISPERSION_ENABLED=false
PRICING_V3_ACTIVATION_ARTIFACT=
PRICING_V3_ACTIVATION_SHA256=
PRICING_COMPARABILITY_V1_AUTOMATIC_ENABLED=false
PRICING_COMPARABILITY_ACTIVATION_ARTIFACT=
PRICING_COMPARABILITY_ACTIVATION_SHA256=
# Deploy shadow first. Move to required only after labelled validation; Marko
# remains advisory-only in every mode and never publishes Prom.ua prices.
PRICING_LLM_COMPARABILITY_MODE=off
PRICING_LLM_PROVIDER=openai_responses
PRICING_LLM_BASE_URL=https://api.openai.com/v1
PRICING_LLM_API_KEY=
PRICING_LLM_MODEL=gpt-5.6-luna
PRICING_LLM_REASONING_EFFORT=xhigh
PRICING_LLM_IMAGE_DETAIL=auto
PRICING_LLM_RATE_VERSION=openai-gpt-5.6-luna-standard-2026-07-30
PRICING_LLM_TIMEOUT_SECONDS=60
PRICING_LLM_MAX_OUTPUT_TOKENS=1600
PRICING_LLM_MAX_IMAGES=4
PRICING_LLM_MAX_CONCURRENCY=4
# Shadow-only AI extraction from retained candidate evidence. The shared
# PRICING_LLM_API_KEY is used; leave mode off until labelled evaluation.
PRICING_AI_EVIDENCE_MODE=off
# Optional dedicated key; when empty the shared PRICING_LLM_API_KEY is used.
PRICING_AI_EVIDENCE_API_KEY=
# Provider-documented stable snapshot only; arbitrary/latest aliases are rejected.
PRICING_AI_EVIDENCE_MODEL=gpt-5.6-luna
PRICING_AI_EVIDENCE_REASONING_EFFORT=medium
PRICING_AI_EVIDENCE_MAX_OUTPUT_TOKENS=1200
PRICING_AI_EVIDENCE_MAX_INPUT_CHARS=20000
PRICING_AI_EVIDENCE_MAX_CALLS_PER_POSITION=4
PRICING_AI_EVIDENCE_MAX_CANDIDATES_PER_POSITION=4
PRICING_AI_EVIDENCE_MAX_CONCURRENCY=2
PRICING_AI_EVIDENCE_ESCALATION_ENABLED=false
PRICING_AI_EVIDENCE_ESCALATION_MODEL=
PRICING_AI_EVIDENCE_ESCALATION_REASONING_EFFORT=
# Fitment belongs to a later phase and has no UI in this delivery, so its 25
# endpoints stay unmounted. See docs/FITMENT_PHASE_BOUNDARY_2026-07-30.md.
FITMENT_API_ENABLED=false
E2E_AUTH_BYPASS=false
E2E_AUTH_TOKEN=
E2E_TASK_HOLD_SECONDS=0
