# TEMPLATE_ONLY=1
# This file is intentionally invalid for deployment until every REQUIRED value is replaced.
ENVIRONMENT=production
DEBUG=false
API_DOCS_ENABLED=false
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@PRIVATE_POSTGRES_HOST:5432/marko
CELERY_BROKER_URL=rediss://USER:PASSWORD@PRIVATE_REDIS_HOST:6380/0
CELERY_RESULT_BACKEND=rediss://USER:PASSWORD@PRIVATE_REDIS_HOST:6380/1
ALLOWED_HOSTS=api.example.com
CORS_ORIGINS=https://app.example.com
FIREBASE_PROJECT_ID=your-firebase-project
TRUSTED_PROXY_IPS=127.0.0.1
PUBLIC_API_BASE_URL=https://api.example.com
FIREBASE_API_KEY=replace
FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=replace
FIREBASE_WEB_APP_ID=replace

# Keep blocked until an official feed or written authorization is recorded.
PROM_MARKETPLACE_SOURCE_ACCESS_VERDICT=NOT_PERMITTED
PROM_MARKETPLACE_SOURCE_ACCESS_REFERENCE=

API_PORT=8000
WEB_PORT=8080
API_WORKERS=2
GENERAL_WORKER_CONCURRENCY=1
STORE_SYNC_WORKER_CONCURRENCY=2
PRICING_WORKER_CONCURRENCY=1

# Fail-closed feature activation. A boolean alone is never sufficient in production.
PRICING_V3_ROBUST_DISPERSION_ENABLED=false
PRICING_V3_ACTIVATION_ARTIFACT=
PRICING_V3_ACTIVATION_SHA256=
PRICING_COMPARABILITY_V1_AUTOMATIC_ENABLED=false
PRICING_COMPARABILITY_ACTIVATION_ARTIFACT=
PRICING_COMPARABILITY_ACTIVATION_SHA256=
E2E_AUTH_BYPASS=false
E2E_AUTH_TOKEN=
E2E_TASK_HOLD_SECONDS=0
