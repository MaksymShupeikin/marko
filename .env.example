# Environment: development / production
ENVIRONMENT=development

# Database & Redis
POSTGRES_DB=marko
POSTGRES_USER=marko
POSTGRES_PASSWORD=marko
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=8080

# Network & Routing
CORS_ORIGINS=http://localhost:8080,https://markoprice.com,https://www.markoprice.com
API_BASE_URL=http://localhost:8000

# Firebase Auth
FIREBASE_PROJECT_ID=marko-4941e
FIREBASE_API_KEY=AIzaSy_REPLACE_ME
FIREBASE_AUTH_DOMAIN=marko-4941e.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=779526440182
FIREBASE_WEB_APP_ID=1:779526440182:web:replace_me
GOOGLE_CLIENT_ID=779526440182-nrkjp7e7pma5lhdandq69hcc5gt0aodu.apps.googleusercontent.com

# AI & Competitor Filtering (OpenAI GPT)
COMPETITOR_FILTER_MODEL=gpt-5-nano
# Пісочниця: недоступні товари видно, але вони не формують статистику.
# Залишити false до ручного приймання живої проби.
COMPETITOR_AVAILABILITY_GATE_ENABLED=false
# Фото-перевірка вживаності: потрібен vision-сумісний endpoint.
# Провайдер без зору (напр. DeepSeek) — вимкніть, щоб не шуміти збоями.
COMPETITOR_PHOTO_CHECK_ENABLED=true
# Порожньо = та сама модель, що й COMPETITOR_FILTER_MODEL.
COMPETITOR_PHOTO_MODEL=
OPENAI_API_KEY=sk-proj-replace-me
OPENAI_BASE_URL=
SERPER_API_KEY=

# Cloudflare Tunnel (VPS production)
CLOUDFLARE_TUNNEL_TOKEN=

# Billing (free checks per workspace; full access granted manually in DB)
FREE_CHECK_LIMIT=30
