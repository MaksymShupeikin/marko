# ==============================================================================
# Marko Environment Configuration
# ==============================================================================

# Environment: "development" for local work, "production" for VPS
ENVIRONMENT=development

# ==============================================================================
# Database & Queues
# ==============================================================================
POSTGRES_DB=marko
POSTGRES_USER=marko
POSTGRES_PASSWORD=marko
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=8080

# ==============================================================================
# Network & CORS Configuration
# ==============================================================================
# For local dev: http://localhost:8080
# For VPS prod: https://markoprice.com,https://www.markoprice.com
CORS_ORIGINS=http://localhost:8080,https://markoprice.com,https://www.markoprice.com

# Public API URL used by the frontend to make requests
# For local dev: http://localhost:8000
# For VPS prod: https://api.markoprice.com
API_BASE_URL=http://localhost:8000

# ==============================================================================
# Firebase Authentication (Web Client)
# Firebase Console -> Project settings -> General -> Your apps -> Web app
# ==============================================================================
FIREBASE_PROJECT_ID=marko-4941e
FIREBASE_API_KEY=AIzaSy_REPLACE_WITH_YOUR_KEY
FIREBASE_AUTH_DOMAIN=marko-4941e.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=779526440182
FIREBASE_WEB_APP_ID=1:779526440182:web:replace_me

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=779526440182-nrkjp7e7pma5lhdandq69hcc5gt0aodu.apps.googleusercontent.com

# ==============================================================================
# AI Models & Competitor Filtering (OpenAI GPT)
# ==============================================================================
COMPETITOR_FILTER_MODEL=gpt-5-nano
OPENAI_API_KEY=sk-proj-your-openai-key-here
OPENAI_BASE_URL=

# Optional: Serper.dev Google Search API Key for extra competitor search
SERPER_API_KEY=

# ==============================================================================
# Cloudflare Tunnel (For Production VPS)
# ==============================================================================
# Token from Cloudflare Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
