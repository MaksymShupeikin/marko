POSTGRES_DB=marko
POSTGRES_USER=marko
POSTGRES_PASSWORD=marko
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=8080
ENVIRONMENT=development
DEBUG=false
API_DOCS_ENABLED=true
ALLOWED_HOSTS=localhost,127.0.0.1,test,testserver
CORS_ORIGINS=http://localhost:8080
CORS_ALLOW_CREDENTIALS=false
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=Authorization,Content-Type,Accept,Origin,X-Request-ID
API_WORKERS=1
GENERAL_WORKER_CONCURRENCY=1
PRICING_WORKER_CONCURRENCY=1
PRICING_COLLECTION_MIN_INTERVAL_SECONDS=2
PRICING_CIRCUIT_FAILURE_THRESHOLD=5
PRICING_CIRCUIT_OPEN_SECONDS=300
PRICING_PARSER_SCHEMA_CHANGED_ALERT_COUNT=0
PRICING_PARSER_SCHEMA_CHANGED_CRITICAL_RATE=0.01
PRICING_OFFER_INTERNAL_FAILURE_ALERT_COUNT=0
PRICING_EVIDENCE_ACCOUNTING_ERROR_CRITICAL_COUNT=0
PRICING_VERIFIED_OE_DROP_WARNING_DELTA=0.20
PRICING_SOURCE_CONFIDENCE_P50_DROP_WARNING_DELTA=0.15
PRICING_DISPATCH_BATCH_SIZE=100
PRICING_COLLECTION_MAX_TASK_EXECUTIONS=4
PRICING_COLLECTION_ITEM_DEADLINE_SECONDS=1800
PRICING_COLLECTION_LEASE_SECONDS=900
PRICING_COLLECTION_TASK_SOFT_TIME_LIMIT_SECONDS=840
PRICING_COLLECTION_TASK_TIME_LIMIT_SECONDS=900
PRICING_SCRAPER_HTTP_TIMEOUT_SECONDS=30
PRICING_SCRAPER_HTTP_MAX_ATTEMPTS=4
PRICING_SCRAPER_REQUEST_DELAY_SECONDS=1
PRICING_SCRAPER_REQUEST_JITTER_SECONDS=0.5
PRICING_SCRAPER_MAX_SEARCH_PAGES=10
# Pages of prom.ua's own part-code listing to walk (30 offers per page).
PRICING_SCRAPER_MAX_OE_PAGE_PAGES=4
PRICING_SCRAPER_MAX_SELLERS=10
# Candidate cards fetched per position; 0 means every external row.
PRICING_SCRAPER_MAX_DETAIL_CARDS=0
# External sellers a position must reach before a declared cross is searched.
PRICING_SCRAPER_MIN_INDEPENDENT_SELLERS=3
# Hours a retained competitor card may be replayed instead of refetched.
PRICING_DETAIL_REPLAY_MAX_AGE_HOURS=72
# Safety hard-cap for the Catalog "Найдено парсером" search. The gateway
# stops earlier when Prom's reported total has been collected or a page repeats.
CATALOG_DISCOVERY_MAX_SEARCH_PAGES=10
# Leave empty for the safe KEMP-only baseline outside Compose. Compose loads
# /app/config/brands.yaml; set an absolute path for a local non-container run.
PRICING_BRAND_TIERS_PATH=
# Deterministic discovery-only candidate gates. Compose loads the audited
# repository config; set an absolute path for a local non-container run.
PRICING_CANDIDATE_SELECTION_PATH=config/comparability.yaml
PRICING_V3_ROBUST_DISPERSION_ENABLED=false
# Semantic candidate gate. Start with shadow, measure customer-confirmed
# precision, then switch to required. "required" excludes every candidate
# without a positive EXACT/ACCEPTABLE_ANALOGUE review from pricing.
PRICING_LLM_COMPARABILITY_MODE=off
PRICING_LLM_PROVIDER=openai_responses
PRICING_LLM_BASE_URL=https://api.openai.com/v1
PRICING_LLM_API_KEY=
PRICING_LLM_MODEL=gpt-5.6-luna
PRICING_LLM_REASONING_EFFORT=xhigh
PRICING_LLM_IMAGE_DETAIL=auto
PRICING_LLM_RATE_VERSION=openai-gpt-5.6-luna-standard-2026-07-30
PRICING_LLM_TIMEOUT_SECONDS=60
PRICING_LLM_MAX_OUTPUT_TOKENS=1600
PRICING_LLM_MAX_IMAGES=4
PRICING_LLM_MAX_CONCURRENCY=4
# AI-assisted extraction from retained candidate evidence. Keep off until an
# operator enables a shadow evaluation; it never grants pricing authority.
# The shared PRICING_LLM_API_KEY is reused and remains empty in source control.
PRICING_AI_EVIDENCE_MODE=off
# Optional dedicated key; when empty the shared PRICING_LLM_API_KEY is used.
PRICING_AI_EVIDENCE_API_KEY=
# Provider-documented stable snapshot only; arbitrary/latest aliases are rejected.
PRICING_AI_EVIDENCE_MODEL=gpt-5.6-luna
PRICING_AI_EVIDENCE_REASONING_EFFORT=medium
PRICING_AI_EVIDENCE_MAX_OUTPUT_TOKENS=1200
PRICING_AI_EVIDENCE_MAX_INPUT_CHARS=20000
PRICING_AI_EVIDENCE_MAX_CALLS_PER_POSITION=4
PRICING_AI_EVIDENCE_MAX_CANDIDATES_PER_POSITION=4
PRICING_AI_EVIDENCE_MAX_CONCURRENCY=2
PRICING_AI_EVIDENCE_ESCALATION_ENABLED=false
PRICING_AI_EVIDENCE_ESCALATION_MODEL=
PRICING_AI_EVIDENCE_ESCALATION_REASONING_EFFORT=
STORE_SYNC_WORKER_CONCURRENCY=2
STORE_SYNC_MAX_TASK_EXECUTIONS=3
STORE_SYNC_ITEM_DEADLINE_SECONDS=3600
STORE_SYNC_LEASE_SECONDS=300
STORE_SYNC_TASK_SOFT_TIME_LIMIT_SECONDS=1740
STORE_SYNC_TASK_TIME_LIMIT_SECONDS=1800
STORE_SYNC_RETRY_BASE_DELAY_SECONDS=30
STORE_SYNC_SCRAPER_HTTP_TIMEOUT_SECONDS=30
STORE_SYNC_SCRAPER_HTTP_MAX_ATTEMPTS=4
STORE_SYNC_SCRAPER_MAX_PAGES=0
SCRAPE_RAW_EVIDENCE_REPLAY_ENABLED=true
SCRAPE_EVIDENCE_GC_BATCH_SIZE=1000
SCRAPE_EVIDENCE_GC_INTERVAL_SECONDS=3600

# Fail closed. Change to PERMITTED_OFFICIAL or PERMITTED_LIMITED only after
# recording an official feed or written authorization reference.
PROM_MARKETPLACE_SOURCE_ACCESS_VERDICT=NOT_PERMITTED
PROM_MARKETPLACE_SOURCE_ACCESS_REFERENCE=
STORE_URL_RESOLVER_TIMEOUT_SECONDS=10
STORE_URL_RESOLVER_MAX_REDIRECTS=3
STORE_URL_RESOLVER_MAX_RESPONSE_BYTES=2097152

# Yuri selected server-side encryption. Keep UNDECIDED until a real external
# 32-byte base64url key is provisioned; never commit that key to this file.
COST_PRIVACY_MODE=UNDECIDED
COST_ENCRYPTION_ACTIVE_KEY_ID=
COST_ENCRYPTION_KEYS_JSON=

# Firebase Console -> Project settings -> General -> Your apps -> Web app.
# These values identify the public client app; they are not admin credentials.
FIREBASE_API_KEY=AIza_REPLACE_ME
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_WEB_APP_ID=1:123456789012:web:replace_me
