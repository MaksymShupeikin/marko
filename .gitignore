# OS-specific files
.DS_Store
Thumbs.db

# IDEs and Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.iml

# Root environment and secret files
.env
.env.local
.env.*.local

# Logs
*.log

# Python environments, bytecode, and tool caches
.venv/
venv/
backend/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Flutter and Dart generated state
.dart_tool/
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
frontend/build/
build/

# Local runtime evidence and generated operator outputs
.artifacts/
outputs/
frontend/test/failures/

# Customer source data stays local; only its provenance manifest is versioned.
backend/data/*
!backend/data/SOURCES.md

# Local databases and temporary files
*.db
*.sqlite
*.sqlite3
*.tmp
*.temp

# Database backups (never commit: contain production data)
/backups/
*.dump
*.dump.sha256
