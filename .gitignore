*.log

# Python environments, bytecode, and tool caches
.venv/
venv/
backend/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Flutter and Dart generated state
.dart_tool/
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
frontend/build/
build/

# Local runtime evidence and generated operator outputs
.artifacts/
outputs/
frontend/test/failures/

# Customer source data is versioned deliberately (2026-08-07, private repo):
# the sha256 table in SOURCES.md is only checkable when the files it pins live
# in the same commit. Database dumps and local stores stay out through the
# *.dump / *.db / *.sqlite rules below, which apply here too.

# Local databases and temporary files
*.db
*.sqlite
*.sqlite3
*.tmp
*.temp

# Database backups (never commit: contain production data)
/backups/
*.dump
*.dump.sha256
